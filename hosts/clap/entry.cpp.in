#include <clap/clap.h>

extern "C" const clap_plugin_entry_t squatch_clap_entry_@KEY@;

namespace {
bool init(const char* path) { return squatch_clap_entry_@KEY@.init(path); }
void deinit() { squatch_clap_entry_@KEY@.deinit(); }
const void* factory(const char* id) { return squatch_clap_entry_@KEY@.get_factory(id); }
}  // namespace

extern "C" {
#ifdef __GNUC__
#pragma GCC diagnostic push
#pragma GCC diagnostic ignored "-Wattributes"
#endif
CLAP_EXPORT const clap_plugin_entry_t clap_entry = {CLAP_VERSION_INIT, init, deinit, factory};
#ifdef __GNUC__
#pragma GCC diagnostic pop
#endif
