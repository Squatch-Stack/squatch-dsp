libDaisy PR #715 (fixes #714), head f0e27d610caf16a0858b3e9459c7e644e0ae33e4, CHANGELOG hunk dropped.
A malformed DISCARD block named libc.a/libm.a/libgcc.a, which loads full newlib into CMake links.
The Make link is byte-identical with or without it (the PR's own check); carried for CMake.

diff --git a/core/STM32H750IB_flash.lds b/core/STM32H750IB_flash.lds
index 6d8e6a439..7ac8227f5 100644
--- a/core/STM32H750IB_flash.lds
+++ b/core/STM32H750IB_flash.lds
@@ -257,12 +257,5 @@ SECTIONS
 		PROVIDE(__reserved_for_stack_end__ = .);
 	} > SRAM
 
-    DISCARD :
-    {
-        libc.a ( * )
-        libm.a ( * )
-        libgcc.a ( * )
-    }
-
 }
 
