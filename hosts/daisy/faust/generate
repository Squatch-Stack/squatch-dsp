#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Regenerate drive_faust.hpp from the overdrive (drive) Faust source. Run by hand when the .dsp changes;
the build never runs Faust, it compiles the committed output.

    hosts/daisy/faust/generate PATH/TO/ts808.dsp            write drive_faust.hpp
    hosts/daisy/faust/generate PATH/TO/ts808.dsp --check    fail if the committed file differs

The .dsp (the overdrive model) is not published; its hash is in the header. Faust's C++ is adapted in five exact places,
each of which must match once, or nothing is written:
  1. the destructor loses `virtual` (a virtual destructor puts a deleting destructor, and so
     operator delete, into every image that constructs the class);
  2. clone() is removed: it is the one member that allocates (`new`), so it cannot be called;
  3. metadata() is removed: it only lists library authors, and carries e-mail addresses;
     the licences it named are recorded in the header comment instead;
  4. buildUserInterface() becomes a template, so the wrapper binds parameters with a plain
     struct and no Faust UI base class (no virtual calls, no RTTI);
  5. the class goes into namespace squatch::faust;
  6. the source's product-name label (a trademark) is replaced by "drive" in the name metadata and the UI box.
Standard library only.
"""
import argparse
import hashlib
import re
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
OUT = HERE / "drive_faust.hpp"
CLASS = "DriveFaust"
OPTIONS = ["-lang", "cpp", "-single", "-ftz", "0", "-nvi", "-cn", CLASS, "-scn", ""]

HEADER = """\
// SPDX-License-Identifier: MIT
// GENERATED by hosts/daisy/faust/generate - do not edit. Regenerate from the overdrive's Faust
// source ({dsp_sha}), {faust}.
//
// Licences. The source is Squatch Stack's own and declares no licence of its own, so this output
// is MIT like the rest of squatch-dsp. It is built from these Faust libraries (their licence lines
// read in Faust 2.85.9's share/faust on 2026-10-17):
//   filters.lib (highpass, lowpass, tf1, tf1s) and the "jos section" of signals.lib (smooth, smoo):
//     Copyright (C) 2003-2019 Julius O. Smith III, MIT-style STK-4.3 licence, whose notice follows;
//   maths.lib (tanh, PI), platform.lib (SR) and the GRAME section of signals.lib: Copyright (C)
//     GRAME, Centre National de Creation Musicale, LGPL 2.1 with the Faust library exception, which
//     lets compiled output be licensed freely ("you are free to choose a commercial or closed source
//     license or any other license").
// The adaptations to Faust's output are listed in the generator.
//
// STK 4.3 licence (Julius O. Smith III, as printed at the end of Faust's filters.lib):
//   Permission is hereby granted, free of charge, to any person obtaining a copy of this software and
//   associated documentation files (the "Software"), to deal in the Software without restriction,
//   including without limitation the rights to use, copy, modify, merge, publish, distribute,
//   sublicense, and/or sell copies of the Software, and to permit persons to whom the Software is
//   furnished to do so, subject to the following conditions:
//   The above copyright notice and this permission notice shall be included in all copies or
//   substantial portions of the Software.
//   Any person wishing to distribute modifications to the Software is asked to send the modifications
//   to the original developer so that they can be incorporated into the canonical version. For
//   software copyrighted by Julius O. Smith III, email your modifications to him at the address printed in Faust's filters.lib.
//   This is, however, not a binding provision of this license.
//   THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT
//   NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
//   NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,
//   DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT
//   OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
"""


def run_faust(dsp: Path) -> str:
    with tempfile.TemporaryDirectory() as tmp:
        out = Path(tmp) / "out.hpp"
        subprocess.run(["faust", *OPTIONS, str(dsp), "-o", str(out)], check=True)
        return out.read_text()


def faust_version() -> str:
    first = subprocess.run(["faust", "--version"], check=True, capture_output=True, text=True).stdout.splitlines()[0]
    return first.strip().replace("FAUST Version", "Faust")


def once(text: str, pattern: str, repl: str, what: str, flags=0) -> str:
    new, n = re.subn(pattern, repl, text, count=0, flags=flags)
    if n != 1:
        sys.exit(f"generate: expected exactly one {what}, found {n}: Faust's output changed shape")
    return new


def adapt(code: str) -> str:
    code = once(code, rf"virtual ~{CLASS}\(\) = default;", f"~{CLASS}() = default;", "virtual destructor")
    code = once(code, rf"\n\t{CLASS}\* clone\(\) \{{\n\t\treturn new {CLASS}\(\*this\);\n\t\}}\n", "\n", "clone()")
    code = once(code, r"\n\tvoid metadata\(Meta\* m\) \{.*?\n\t\}\n", "\n", "metadata()", re.S)
    code = once(code, r"\tvoid buildUserInterface\(UI\* ui_interface\)", "\ttemplate <class UI>\n\tvoid buildUserInterface(UI* ui_interface)",
                "buildUserInterface()")
    code = once(code, rf"\nstatic float {CLASS}_faustpower2_f", f"\nnamespace squatch::faust {{\n\nstatic float {CLASS}_faustpower2_f",
                "helper to open the namespace")
    code = once(code, r"\n\};\n\n#endif", "\n};\n\n}  // namespace squatch::faust\n\n#endif", "class end")
    code = once(code, r'name: "TS808"', 'name: "drive"', "name metadata")
    code = once(code, r'openVerticalBox\("TS808"\)', 'openVerticalBox("drive")', "UI box label")
    for banned in ("new ", "malloc", "Meta*", "virtual"):
        if banned in code:
            sys.exit(f"generate: '{banned}' is still in the output")
    return code


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("dsp", type=Path)
    ap.add_argument("--check", action="store_true", help="compare with the committed file instead of writing it")
    a = ap.parse_args()
    dsp_sha = "sha256 " + hashlib.sha256(a.dsp.read_bytes()).hexdigest()[:16]
    text = HEADER.format(dsp_sha=dsp_sha, faust=faust_version()) + adapt(run_faust(a.dsp))
    if a.check:
        same = OUT.exists() and OUT.read_text() == text
        print(f"generate: {OUT.name} {'matches' if same else 'DIFFERS from'} {a.dsp}")
        return 0 if same else 1
    OUT.write_text(text)
    print(f"generate: wrote {OUT.name} from {a.dsp.name} ({dsp_sha})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
