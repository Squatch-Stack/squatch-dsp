"""Tests for tools/release-scan, each guard with its negative control: a clean tree passes, and the
same tree with one planted problem fails. Run: tools/test-release-scan"""
import importlib.machinery
import importlib.util
import io
import os
import sys
import tempfile
import unittest
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("release_scan", str(HERE / "release-scan"))
scan = importlib.util.module_from_spec(importlib.util.spec_from_loader("release_scan", loader))
loader.exec_module(scan)

GHP = "ghp_" + "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8"


def hits(files, allow=()):
    with tempfile.TemporaryDirectory() as d:
        for name, data in files.items():
            (Path(d) / name).parent.mkdir(parents=True, exist_ok=True)
            (Path(d) / name).write_bytes(data if isinstance(data, bytes) else data.encode())
        return scan.scan_path(d, list(allow))


class Scan(unittest.TestCase):
    def test_clean_tree_passes_and_music_a4_is_not_a_code_name(self):
        self.assertEqual(hits({"a.cpp": "// A4 = 440 Hz, concert pitch\nint main() {}\n"}), [])

    def test_home_path_in_a_binary_is_found(self):
        self.assertTrue(hits({"p.wasm": b"\x00asm\x00" + b"\x00/Use" + b"rs/someone/src/a.cpp\x00"}))
        self.assertEqual(hits({"p.wasm": b"\x00asm\x00" + b"\x00./src/a.cpp\x00"}), [])

    def test_token_is_found_and_a_short_lookalike_is_not(self):
        self.assertTrue(hits({"n.txt": f"token {GHP}"}))
        self.assertEqual(hits({"n.txt": "ghp_short"}), [])

    def test_trademark_is_found_and_only_the_named_sentence_is_forgiven(self):
        allow = [("bench/*", scan.re.compile("Ibanez Power Strat"))]
        self.assertTrue(hits({"x.md": "a Tube Screamer clone"}))
        self.assertEqual(hits({"bench/x.txt": "dataset guitar: Ibanez Power Strat"}, allow), [])
        self.assertTrue(hits({"bench/x.txt": "an Ibanez TS-808"}, allow))
        self.assertTrue(hits({"other/x.txt": "dataset guitar: Ibanez Power Strat"}, allow))

    def test_a_member_of_a_zip_is_scanned(self):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            z.writestr("Plugin.clap/Contents/MacOS/p", b"\x00\x00built in /Use" + b"rs/runner/work/x.cpp\x00")
        found = hits({"plugins.zip": buf.getvalue()})
        self.assertTrue(found and "plugins.zip!Plugin.clap" in found[0])

    def test_the_old_pedal_label_and_hyphenated_trademark_are_found(self):
        self.assertTrue(hits({"a.json": '{"label": "' + "TS" + ' Drive"}'}))
        self.assertTrue(hits({"a.md": "Tube-" + "screamer-style overdrive"}))
        self.assertEqual(hits({"a.md": "results drive the loop; Trail Drive"}), [])

    def test_a_broken_scanner_is_refused(self):
        saved = scan.RULES
        scan.RULES = []
        try:
            self.assertFalse(scan.self_check())
        finally:
            scan.RULES = saved
        self.assertTrue(scan.self_check())


FAKE = "zq" + "fake" + "term" + "xv"
SCANNER = Path.home() / "bin" / "squatch-privacy"


@unittest.skipUnless(SCANNER.is_file(), "the owner's private-term scanner exists only on the owner's machine")
class OwnerTerms(unittest.TestCase):
    """The owner's private terms are never in this repo: the scan reuses the scanner outside it. These tests point it at
    a scratch list holding a made-up term and plant that term everywhere a real one could hide."""

    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        (Path(self.tmp.name) / "terms").write_text(f"name|word|{FAKE}\n")
        self.old_dir = os.environ.get("SQUATCH_PRIVACY_DIR")
        os.environ["SQUATCH_PRIVACY_DIR"] = self.tmp.name
        self.saved = scan.PRIV
        scan.PRIV = scan.load_privacy()

    def tearDown(self):
        scan.PRIV = self.saved
        if self.old_dir is None:
            os.environ.pop("SQUATCH_PRIVACY_DIR", None)
        else:
            os.environ["SQUATCH_PRIVACY_DIR"] = self.old_dir
        self.tmp.cleanup()

    def test_a_planted_term_is_found_in_text_a_name_a_binary_utf16_and_a_zip(self):
        buf = io.BytesIO()
        with zipfile.ZipFile(buf, "w") as z:
            z.writestr("Plugin/info.txt", f"Developer ID: {FAKE}")
        found = hits({
            "about.html": f"by {FAKE}",
            f"{FAKE}.txt": "x",
            "b.bin": b"\x00\x01 ok " + FAKE.encode() + b" tail \x00",
            "u.dat": b"\x00\x01" + f"Signed {FAKE} here".encode("utf-16le"),
            "p.zip": buf.getvalue(),
        })
        text = "\n".join(found)
        for part in ("about.html", "file name", "b.bin", "u.dat", "p.zip!Plugin/info.txt"):
            self.assertIn(part, text, text)
        self.assertIn("term #1", text)
        self.assertNotIn(FAKE, text.replace(f"{FAKE}.txt", ""), "the term was printed")

    def test_a_clean_tree_passes_and_a_missing_term_list_is_refused(self):
        self.assertEqual(hits({"a.txt": "Squatch Stack"}), [])
        (Path(self.tmp.name) / "terms").write_text("# nothing\n")
        with self.assertRaises(Exception):
            scan.load_privacy()

    def test_without_the_scanner_the_scan_still_runs_and_says_so(self):
        self.assertIsNone(scan.load_privacy(Path(self.tmp.name) / "no-such-scanner"))


if __name__ == "__main__":
    unittest.main(verbosity=1)
