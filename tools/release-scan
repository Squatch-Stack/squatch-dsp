#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Fails if a source tree or a built release artifact names what must not ship: private code
names and lineage, home and network paths, other people's trademarks, or a credential.

    tools/release-scan [--allow FILE] PATH...      PATH is a directory (walked) or a file

Text files are read as text. Everything else (plugin bundles, libraries, executables, WebAssembly,
zip archives of them) is read the way `strings -n 5` reads it, so a name compiled into a binary is
found as well as one in a comment. A .zip is unpacked in memory and scanned member by member.

Private patterns (code names, lineage) live in tools/release-scan.private, which is not published; the
public script carries only generic ones. The export guard checks the source for them before every export.

Allowlist (default tools/release-scan.allow, next to this script): one `path-glob  regex` per line,
`#` comments. A hit is forgiven only when its file matches the glob AND its line matches the regex,
so each exception names the exact sentence it covers.

Self-check: the negative controls (a planted home path in a fake .wasm, a fake GitHub token) are
run first; if either is not caught, the scan itself is broken and it exits 2 without scanning.
Exit 0 clean, 1 findings, 2 broken scanner or bad usage. Standard library only.
"""
import argparse
import fnmatch
import io
import re
import sys
import tempfile
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
# Home paths, secrets folders and LAN addresses: never in a shipped file. The private code names and
# lineage patterns are not written here (this script is published): tools/release-scan.private, one
# regex per line, stays in the development tree and is read when it is present.
LINEAGE = r"/Users/[A-Za-z]|/home/[a-z]|\b192\.168\.|~/\.secrets"
# Other people's marks: allowed only in a sentence the allowlist names.
TRADEMARKS = r"\bRATs?\b|TS-?808|Tube ?Screamer|\bKlon\b|Centaur|\bProCo\b|Ibanez"
SECRETS = (
    r"\bgh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|\bAKIA[0-9A-Z]{16}\b"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----|\bxox[baprs]-[A-Za-z0-9-]{10,}"
)
PRIVATE = HERE / "release-scan.private"
if PRIVATE.is_file():
    LINEAGE += "|" + "|".join(x.split("#", 1)[0].strip() for x in PRIVATE.read_text().splitlines()
                              if x.split("#", 1)[0].strip())
RULES = [(re.compile(LINEAGE, re.I), "private lineage, infrastructure or path"),
         (re.compile(TRADEMARKS, re.I), "a trademark"),
         (re.compile(SECRETS), "a credential")]
# Rules that are case-sensitive in spirit are kept loose on purpose: a false hit is reviewed, a miss ships.
STRINGS = re.compile(rb"[\x20-\x7e]{5,}")
SKIP_DIRS = {".git", "node_modules", "build", "__pycache__"}
SKIP_FILES = {"release-scan", "release-scan.allow", "release-scan.private", "test-release-scan"}
MEDIA = {".png", ".jpg", ".jpeg", ".gif", ".ico", ".webp", ".woff", ".woff2", ".wav", ".f32", ".mp3"}


def load_allow(path):
    out = []
    if path and Path(path).is_file():
        for raw in Path(path).read_text().splitlines():
            line = raw.split("#", 1)[0].rstrip()
            if line.strip():
                glob, _, rx = line.strip().partition("  ")
                out.append((glob.strip(), re.compile(rx.strip() or ".")))
    return out


def lines_of(data):
    if b"\x00" in data[:8192]:
        return [m.group().decode("ascii") for m in STRINGS.finditer(data)]
    return data.decode("utf-8", errors="replace").splitlines()


def scan_lines(name, lines, allow):
    hits = []
    for n, line in enumerate(lines, 1):
        for rx, why in RULES:
            m = rx.search(line)
            if m and not any(fnmatch.fnmatch(name, g) and a.search(line) for g, a in allow):
                hits.append(f"{name}:{n}: {why}: {line.strip()[max(0, m.start() - 20):m.end() + 40]}")
                break
    return hits


def scan_blob(name, data, allow):
    if name.lower().endswith(".zip"):
        hits = []
        with zipfile.ZipFile(io.BytesIO(data)) as z:
            for info in z.infolist():
                if not info.is_dir():
                    hits += scan_blob(f"{name}!{info.filename}", z.read(info), allow)
        return hits
    if Path(name).suffix.lower() in MEDIA:
        return []
    return scan_lines(name, lines_of(data), allow)


def scan_path(root, allow):
    root = Path(root)
    files = [root] if root.is_file() else sorted(
        f for f in root.rglob("*") if f.is_file() and not SKIP_DIRS.intersection(f.relative_to(root).parts))
    hits = []
    for f in files:
        if f.name in SKIP_FILES:
            continue
        rel = f.name if root.is_file() else f.relative_to(root).as_posix()
        hits += scan_blob(rel, f.read_bytes(), allow)
    return hits


def self_check():
    """A planted home path in a binary and a fake token must both fail a scan."""
    with tempfile.TemporaryDirectory() as d:
        (Path(d) / "model.wasm").write_bytes(b"\x00asm\x01\x00\x00\x00" + b"\x00built in /Use" b"rs/someone/src/x.cpp\x00")
        (Path(d) / "notes.txt").write_text("token = " + "ghp_" + "a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8" + "\n")
        found = scan_path(d, [])
    return any("model.wasm" in h for h in found) and any("notes.txt" in h for h in found)


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("paths", nargs="+")
    ap.add_argument("--allow", default=str(HERE / "release-scan.allow"))
    args = ap.parse_args(argv)
    if not self_check():
        print("release-scan: the negative controls were not caught; the scanner is broken", file=sys.stderr)
        return 2
    allow = load_allow(args.allow)
    hits = [h for p in args.paths for h in scan_path(p, allow)]
    for h in hits[:100]:
        print(f"  {h}")
    print(f"release-scan: {'FAIL' if hits else 'PASS'} ({len(hits)} findings)")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
