#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Compiles the control contracts (contracts/*.params.json, profile cc.squatch.control/1) into
what squatch-dsp builds from, so one contract drives every format:

  include/squatch/dsp/contracts/<key>.hpp   the ParamDesc table, the Param enum and BlockInfo
  hosts/clap/generated/<key>.cpp            the plugin's CLAP entry (ClapPlugin<Block>)
  hosts/clap/generated/plugins.cmake        name, id, version and AU codes for CMake
  hosts/clap/generated/plugins-private.cmake  the same for contracts tools/private-paths keeps
                                            out of the public export (written only when any are)
  hosts/clap/generated/plugins-<dep>.cmake  the same for blocks whose product names
                                            "requires": "<dep>": host-side blocks built on a
                                            pinned third-party library (the NAM amp on NAM Core),
                                            which only a host that builds <dep> lists

The checks are squatch-skin's checkDescriptor() (lib/contract.mjs) plus what a block needs: a
C++ class, a version, one bypass, value roles only (and trigger: a 0..1 toggle whose rising edge
starts something; the skin's emitters see it as a param with "trigger": true). With --formats
DIR it also runs the skin's own emitters (LV2 Turtle, WAM, OSCQuery, MIDI-CI) on these contracts
into DIR; that needs Node and a squatch-skin checkout ($SQUATCH_SKIN, or a sibling of this
repository).

  tools/build-contracts [--check] [--formats DIR]
"""
import fnmatch
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROFILE = "cc.squatch.control/1"
UNITS = {None: "", "db": "dB", "hz": "Hz", "ms": "ms", "s": "s", "pc": "%", "cent": "cent"}
ROLES = {"param": "Role::Param", "bypass": "Role::Bypass", "meter": "Role::Meter", "trigger": "Role::Trigger"}
TAPERS = {"linear": "Taper::Linear", "log": "Taper::Log", "exp": "Taper::Exp"}
SYMBOL = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
HEADER = "// SPDX-License-Identifier: MIT\n// Generated by tools/build-contracts from contracts/{src}. Do not edit.\n"


def check_param(p, seen):
    at = f"param {p.get('key', p.get('id'))}"
    out = []
    if not isinstance(p.get("id"), int) or not 0 <= p["id"] <= 0xFFFFFFFE:
        out.append(f"{at}: id must be a u32 (CLAP clap_id)")
    if not SYMBOL.match(p.get("key", "")):
        out.append(f"{at}: key must be an LV2 symbol")
    for field in ("id", "key"):
        if p.get(field) in seen[field]:
            out.append(f"{at}: {field} used twice; ids and keys are never reused")
        seen[field].add(p.get(field))
    if p.get("role") not in ROLES:
        out.append(f"{at}: role {p.get('role')} is not a value role (param, bypass, meter, trigger)")
    if p.get("role") == "trigger" and (p.get("min"), p.get("max"), p.get("steps")) != (0, 1, 1):
        out.append(f"{at}: a trigger is a 0..1 toggle (min 0, max 1, steps 1)")
    return out + check_range(p, at)


def check_range(p, at):
    out = []
    lo, hi, d = p.get("min"), p.get("max"), p.get("default")
    if not (isinstance(lo, (int, float)) and isinstance(hi, (int, float)) and lo < hi):
        return [f"{at}: needs min < max"]
    if not (isinstance(d, (int, float)) and lo <= d <= hi):
        out.append(f"{at}: default outside [min, max]")
    if p.get("unit") not in UNITS:
        out.append(f"{at}: unit {p.get('unit')} is not in the LV2 units table")
    taper = p.get("taper", "linear")
    if taper not in TAPERS:
        out.append(f"{at}: taper must be linear, log or exp")
    if taper == "log" and lo <= 0:
        out.append(f"{at}: a log taper needs min > 0")
    if taper == "exp" and not p.get("exponent", 0) > 0:
        out.append(f"{at}: an exp taper needs exponent > 0")
    choices = p.get("choices")
    if choices and len(choices) != p.get("steps", 0) + 1:
        out.append(f"{at}: choices must name each of the steps + 1 positions")
    return out


def check_product(src):
    prod = src.get("product", {})
    out = [] if src.get("profile") == PROFILE else [f"profile must be {PROFILE}"]
    for field in ("id", "key", "name", "block", "header", "version", "description"):
        if not isinstance(prod.get(field), str) or not prod[field]:
            out.append(f"product.{field} is required")
    if not re.match(r"^\d+\.\d+\.\d+$", prod.get("version", "")):
        out.append("product.version must be semver MAJOR.MINOR.PATCH")
    if not isinstance(prod.get("stateVersion"), int) or prod["stateVersion"] < 1:
        out.append("product.stateVersion must be an integer >= 1")
    if len(prod.get("auSubtype", "")) != 4:
        out.append("product.auSubtype must be four characters")
    if not prod.get("features"):
        out.append("product.features must name at least one CLAP feature")
    if "requires" in prod and not re.match(r"^[a-z][a-z0-9_]*$", str(prod["requires"])):
        out.append("product.requires must be a lower-case dependency name")
    return out


def check(src):
    out = check_product(src)
    seen = {"id": set(), "key": set()}
    for p in src.get("params", []):
        out += check_param(p, seen)
    bypass = sum(1 for p in src.get("params", []) if p.get("role") == "bypass")
    if bypass != 1:
        out.append("exactly one bypass parameter (CLAP_PARAM_IS_BYPASS), found %d" % bypass)
    return out


def enumerator(key):
    return "".join(part[:1].upper() + part[1:] for part in key.split("_"))


def ordered(params):
    """Dense ids: the settable parameters (triggers among them), then the bypass, then the meters
    (stable within each)."""
    rank = {"param": 0, "trigger": 0, "bypass": 1, "meter": 2}
    return sorted(params, key=lambda p: rank[p["role"]])


def num(v):
    return f"{float(v)!r}f".replace("inf", "INFINITY")


def cstr(s):
    return json.dumps(s or "")


def descriptor(p, labels):
    fields = [enumerator(p["key"]), cstr(p["name"]), cstr(UNITS[p.get("unit")]), num(p["min"]), num(p["max"]),
              num(p["default"]), num(p.get("smoothMs", 0)), cstr(p["key"]), f"{p['id']}u", ROLES[p["role"]],
              TAPERS[p.get("taper", "linear")], num(p.get("exponent", 1)), str(p.get("steps", 0)), labels,
              cstr(p.get("shortName", p["name"])), cstr(p.get("group", "")),
              str(p.get("display", {}).get("decimals", 2)), num(p.get("rateHz", 0))]
    return "      {" + ", ".join(fields) + "},"


def label_arrays(params):
    lines, names = [], {}
    for p in params:
        if p.get("choices"):
            name = f"k{enumerator(p['key'])}Labels"
            by_value = [c["label"] for c in sorted(p["choices"], key=lambda c: c["value"])]
            lines.append(f"  static constexpr const char* {name}[] = {{{', '.join(cstr(x) for x in by_value)}}};")
            names[p["key"]] = name
    return lines, names


def enum_line(params):
    names = [enumerator(p["key"]) for p in params]
    settable = sum(1 for p in params if p["role"] in ("param", "trigger"))
    parts = names[:settable] + ["kParamCount"]
    rest = names[settable:]
    if rest:
        parts.append(f"{rest[0]} = kParamCount")
        parts += rest[1:]
    return "  enum Param : ParamId { " + ", ".join(parts + ["kCount"]) + " };"


def cpp_header(src, name):
    prod, params = src["product"], ordered(src["params"])
    labels, label_names = label_arrays(params)
    rows = [descriptor(p, label_names.get(p["key"], "nullptr")) for p in params]
    info = (f"  static constexpr BlockInfo kInfo{{{cstr(prod['id'])}, {cstr(prod['name'])}, {cstr(prod.get('house', ''))}, "
            f"{cstr(prod['version'])}, {prod['stateVersion']}u}};")
    body = [HEADER.format(src=name) + f"// {prod['description']}", "#pragma once", "#include <squatch/dsp/block.hpp>", "",
            "namespace squatch::dsp::contracts {", "",
            f"/// {prod['name']} ({prod['id']}): what a {prod['block']} block inherits from its contract.",
            f"struct {prod['block']}Contract {{", enum_line(params), *labels,
            "  // {id, name, unit, min, max, def, smoothMs, key, stableId, role, taper, exponent, steps, labels,",
            "  //  shortName, group, decimals, rateHz}",
            "  static constexpr ParamDesc kParams[] = {", *rows, "  };", info,
            "  static constexpr Span<const ParamDesc> params() { return kParams; }",
            "  static_assert(sizeof(kParams) / sizeof(kParams[0]) == kCount, \"one descriptor per id\");",
            "};", "", "}  // namespace squatch::dsp::contracts", ""]
    return "\n".join(body)


def entry_source(src, name):
    prod = src["product"]
    feats = ", ".join(cstr(f) for f in prod["features"])
    return "\n".join([HEADER.format(src=name) + f"// The {prod['name']} plugin: its block behind the generic CLAP adapter.",
                      '#include "../clap_plugin.hpp"', f"#include <{prod['header']}>", "",
                      f"SQUATCH_CLAP_PLUGIN({prod['key']}, squatch::dsp::{prod['block']},",
                      f"                    {cstr(prod['description'])},", f"                    {feats})", ""])


def cmake_list(contracts, private=False):
    lines = ["# SPDX-License-Identifier: MIT", "# Generated by tools/build-contracts from contracts/*.params.json. Do not edit.",
             "# squatch_plugin(<key> <display name> <clap id> <version> <AU subtype>)"]
    if private:
        lines.insert(2, "# Contracts tools/private-paths keeps out of the public export; CMake includes this if present.")
    for src in contracts:
        p = src["product"]
        lines.append(f"squatch_plugin({p['key']} \"{p['name']}\" {p['id']} {p['version']} {p['auSubtype']})")
    return "\n".join(lines) + "\n"


def private_patterns():
    """tools/private-paths (fnmatch, # comments); absent in a public checkout, so nothing is private there."""
    path = ROOT / "tools/private-paths"
    if not path.is_file():
        return []
    return [line.split("#", 1)[0].strip() for line in path.read_text().splitlines() if line.split("#", 1)[0].strip()]


PRIVATE_LIST = ROOT / "hosts/clap/generated/plugins-private.cmake"


def outputs(contracts, names):
    out = {}
    pats = private_patterns()
    private = [any(fnmatch.fnmatch(f"contracts/{name}", p) for p in pats) for name in names]
    for src, name in zip(contracts, names):
        key = src["product"]["key"]
        out[ROOT / "include/squatch/dsp/contracts" / f"{key}.hpp"] = cpp_header(src, name)
        out[ROOT / "hosts/clap/generated" / f"{key}.cpp"] = entry_source(src, name)
    needs = [c["product"].get("requires") for c in contracts]
    out[ROOT / "hosts/clap/generated/plugins.cmake"] = cmake_list(
        [c for c, p, r in zip(contracts, private, needs) if not p and not r])
    for dep in sorted({r for r in needs if r}):
        out[ROOT / "hosts/clap/generated" / f"plugins-{dep}.cmake"] = cmake_list(
            [c for c, r in zip(contracts, needs) if r == dep])
    if any(private):
        out[PRIVATE_LIST] = cmake_list([c for c, p in zip(contracts, private) if p], private=True)
    return out


def skin_dir():
    for d in (os.environ.get("SQUATCH_SKIN"), ROOT.parent / "squatch-skin", ROOT.parent.parent / "squatch-skin"):
        if d and (Path(d) / "lib/contract.mjs").exists():
            return Path(d)
    return None


def other_formats(files, dest):
    """LV2, WAM, OSCQuery and MIDI-CI from the same contracts, by squatch-skin's own code."""
    skin = skin_dir()
    if not skin:
        print("formats: no squatch-skin checkout (set SQUATCH_SKIN)")
        return False
    script = (f"import('{(skin / 'lib/contract.mjs').as_uri()}').then(m => {{ const fs = require('fs');"
              "for (const f of process.argv.slice(1, -1)) { const s = JSON.parse(fs.readFileSync(f, 'utf8'));"
              "for (const p of s.params) if (p.role === 'trigger') p.role = 'param', p.trigger = true;"
              "const bad = m.checkDescriptor(s); if (bad.length) { console.log(f, bad); process.exitCode = 1; continue; }"
              "const d = process.argv.at(-1) + '/' + s.product.key;"
              "fs.writeFileSync(d + '.lv2.ttl', m.toLv2(s)); fs.writeFileSync(d + '.wam.json', JSON.stringify(m.toWam(s), null, 2));"
              "fs.writeFileSync(d + '.oscquery.json', JSON.stringify(m.toOscQuery(s), null, 2));"
              "fs.writeFileSync(d + '.midi-ci.json', JSON.stringify(m.toMidiCi(s), null, 2)); console.log('formats:', s.product.key); } })")
    Path(dest).mkdir(parents=True, exist_ok=True)
    return subprocess.run(["node", "-e", script, *map(str, files), str(dest)]).returncode == 0


def write_or_check(out, check_only):
    stale = 0
    if PRIVATE_LIST.exists() and PRIVATE_LIST not in out:
        print(f"stale {PRIVATE_LIST.relative_to(ROOT)}: no private contract left; delete it")
        stale += 1
    for path, body in out.items():
        if check_only:
            if not path.exists() or path.read_text() != body:
                print(f"stale {path.relative_to(ROOT)}: run tools/build-contracts")
                stale += 1
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists() or path.read_text() != body:
            path.write_text(body)
            print(f"wrote {path.relative_to(ROOT)}")
    return stale == 0


def main(argv):
    files = sorted((ROOT / "contracts").glob("*.params.json"))
    contracts = [json.loads(f.read_text()) for f in files]
    problems = [f"{f.name}: {p}" for f, c in zip(files, contracts) for p in check(c)]
    if problems:
        print("\n".join(problems))
        return 1
    ok = write_or_check(outputs(contracts, [f.name for f in files]), "--check" in argv)
    if "--formats" in argv:
        ok = other_formats(files, argv[argv.index("--formats") + 1]) and ok
    print(f"contracts: {len(files)} checked" + ("" if ok else " (FAILED)"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
